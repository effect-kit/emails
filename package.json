{
  "name": "effect-kit-emails-workspace",
  "private": true,
  "description": "Development workspace for @effect-kit/emails.",
  "homepage": "https://github.com/effect-kit/emails#readme",
  "bugs": {
    "url": "https://github.com/effect-kit/emails/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Effect Kit Contributors",
    "url": "https://github.com/effect-kit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/effect-kit/emails.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "prepare": "lefthook install",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck typecheck:test && tsc --project tsconfig.json --noEmit",
    "typecheck:test": "turbo run typecheck:test",
    "check:package": "turbo run check:package",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only --ignore-scripts && pnpm format",
    "test:e2e": "turbo run test:e2e",
    "test:consumer": "turbo run test:consumer",
    "test:artifacts": "pnpm test:e2e && pnpm check:package && pnpm test:consumer -- --fixture all",
    "verify": "pnpm check && pnpm test:artifacts",
    "release:pack": "changeset pack --out-dir packages/emails/test/results/release",
    "release:check": "pnpm --filter @effect-kit/emails test:release --fixture core",
    "release:smoke": "pnpm --filter @effect-kit/emails test:release:registry --fixture core",
    "ci:check": "pnpm check",
    "release:prepare": "pnpm check",
    "release:version": "pnpm version-packages",
    "test:compat": "pnpm test:consumer -- --fixture react-resend --typescript 7.1.0-beta",
    "test:extended": "pnpm test:artifacts && pnpm test:compat"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@effect/vitest": "catalog:",
    "@types/node": "24.19.2",
    "effect": "catalog:",
    "klarity": "catalog:",
    "lefthook": "2.2.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "publint": "0.3.25",
    "tsdown": "catalog:",
    "turbo": "2.11.10",
    "typescript": "catalog:",
    "vite": "8.3.5",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.22.0",
    "pnpm": ">=12.14.0 <13"
  },
  "packageManager": "pnpm@12.14.0"
}
