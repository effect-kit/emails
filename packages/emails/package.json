{
  "name": "@effect-kit/emails",
  "version": "0.0.0",
  "description": "Effect v4 native email services and interchangeable provider layers.",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./nodemailer": {
      "workspace-source": "./src/nodemailer.ts",
      "default": "./dist/nodemailer.js"
    },
    "./resend": {
      "workspace-source": "./src/resend.ts",
      "default": "./dist/resend.js"
    },
    "./ses": {
      "workspace-source": "./src/ses.ts",
      "default": "./dist/ses.js"
    },
    "./testing": {
      "workspace-source": "./src/testing.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json",
    "./azure": {
      "workspace-source": "./src/azure.ts",
      "default": "./dist/azure.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./nodemailer": "./dist/nodemailer.js",
      "./resend": "./dist/resend.js",
      "./ses": "./dist/ses.js",
      "./testing": "./dist/testing.js",
      "./package.json": "./package.json",
      "./azure": "./dist/azure.js"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const path of ['dist', '.test-dist', 'coverage']) rmSync(path, { recursive: true, force: true })\"",
    "lint": "oxlint --deny-warnings src",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:test": "tsc --project tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build",
    "check:package": "publint && attw --pack --profile esm-only",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:consumer": "tsdown --config tsdown.consumer.config.ts && node .test-dist/consumer.js"
  },
  "devDependencies": {
    "@aws-sdk/client-sesv2": "3.1157.0",
    "@azure/communication-email": "1.1.0",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "klarity": "catalog:",
    "mailparser": "3.12.4",
    "nodemailer": "10.2.1",
    "resend": "6.34.1",
    "smtp-server": "3.21.1",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@aws-sdk/client-sesv2": "3.1157.0",
    "@azure/communication-email": "1.1.0",
    "effect": "^4.0.6",
    "nodemailer": "10.2.1",
    "resend": "6.34.1"
  },
  "peerDependenciesMeta": {
    "resend": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    },
    "@aws-sdk/client-sesv2": {
      "optional": true
    },
    "@azure/communication-email": {
      "optional": true
    }
  }
}
